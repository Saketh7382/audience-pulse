APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=human

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/audience_intelligence
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Muvion Audience Pulse
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=3

ANALYZER_MENTION_MODEL=google/gemini-3.5-flash-lite
ANALYZER_THEME_MODEL=google/gemini-3.5-flash
ANALYZER_NARRATIVE_MODEL=google/gemini-3.5-flash
ANALYZER_SYNTHESIS_MODEL=google/gemini-3.5-flash
# Optional comma-separated fallback chain accepted by OpenRouter.
ANALYZER_FALLBACK_MODELS=openai/gpt-5-mini
ANALYZER_MENTION_BATCH_SIZE=25
ANALYZER_STORAGE_ROOT=.analyzer-data
ANALYZER_VERSION=0.1.0
PROMPT_BUNDLE_VERSION=v1

REDIS_ANALYSIS_JOB_STREAM=audience:analysis:jobs
REDIS_ANALYSIS_EVENT_STREAM=audience:analysis:events
REDIS_ANALYSIS_CONSUMER_GROUP=audience-pulse-workers
REDIS_ANALYSIS_DEAD_LETTER_STREAM=audience:analysis:jobs:dead-letter
REDIS_STREAM_MAXLEN=1000
REDIS_BLOCK_MS=5000
REDIS_BATCH_SIZE=1
REDIS_PENDING_IDLE_MS=60000
REDIS_MAX_DELIVERY_ATTEMPTS=3

